{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "中國象棋",
  "version": "1.4.0",
  "identifier": "app.xiangqi.local",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 3000 --strictPort",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "中國象棋",
        "width": 1020,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#0c0c10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://github.com https://*.github.com https://*.githubusercontent.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "startMenuFolder": "中國象棋"
      }
    },
    "shortDescription": "中国象棋 · 小而美",
    "longDescription": "本地中国象棋：棋盘 · 三档 AI · 离线语音 · 安静暗色界面"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0QzZERkIyQTQyQkZDRDAKUldUUS9DdWtzdC9HOUhFVDd4VGdqZ3U3Z1B4bVRxVzZxNlNwTW54Yk1OREFLd1c1ejNxdTdCSmkK",
      "endpoints": [
        "https://github.com/hkm-a/xiangqi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
